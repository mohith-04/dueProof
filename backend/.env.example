# Copy to backend/.env for local development. Never commit the real .env.

# Generate one with: python -c "import secrets; print(secrets.token_urlsafe(50))"
SECRET_KEY=change-mee

DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=http://localhost:5173

# Local Postgres (recommended, matches production):
# DATABASE_URL=postgres://postgres:postgres@localhost:5432/dueproof
# Or SQLite for a quick start:
DATABASE_URL=postgresql://postgres:ylwhb7ZA3zUuzaRW@db.uhzxjulyakiqnrahymlg.supabase.co:5432/postgres

# Where uploaded evidence files are stored (default: backend/media). On Railway: a volume path, e.g. /data/media
# MEDIA_ROOT=/data/media
# Or an S3-compatible bucket instead of disk (e.g. Supabase Storage → S3 connection):
# S3_BUCKET=evidence
# S3_ENDPOINT_URL=https://<project-ref>.storage.supabase.co/storage/v1/s3
# S3_REGION=ap-south-1
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
